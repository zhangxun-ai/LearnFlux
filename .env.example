# LearnFlux environment configuration
#
# Quick start:
#   cp .env.example .env
#   chmod 600 .env
#
# Do not commit .env or any real credentials.

# -----------------------------------------------------------------------------
# Persistence
# -----------------------------------------------------------------------------
# sqlite: safe default; stores metadata under data/.
# postgres: uses DATABASE_URL. Enable only after PostgreSQL compatibility and
# data migration have been completed for the deployment.
LEARNFLUX_PERSISTENCE_BACKEND=sqlite

# Local PostgreSQL connection parameters.
# Use a dedicated database per project. A separate schema is normally not
# needed when POSTGRES_DB is dedicated to LearnFlux.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=learnflux
POSTGRES_SSLMODE=disable

# Maintenance connection used to create/check the project database.
POSTGRES_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/postgres?sslmode=${POSTGRES_SSLMODE}

# Application connection. The project reads this value when the persistence
# backend is postgres. URL-encode special characters in the password.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=${POSTGRES_SSLMODE}

# -----------------------------------------------------------------------------
# Object storage
# -----------------------------------------------------------------------------
# local: store temporary source media on the local filesystem.
# s3: require every LEARNFLUX_S3_* credential below.
LEARNFLUX_OBJECT_BACKEND=local
LEARNFLUX_S3_ENDPOINT_URL=
LEARNFLUX_S3_BUCKET=
LEARNFLUX_S3_REGION=
LEARNFLUX_S3_ACCESS_KEY_ID=
LEARNFLUX_S3_SECRET_ACCESS_KEY=
LEARNFLUX_S3_PRESIGN_TTL_SECONDS=900
LEARNFLUX_SOURCE_RETENTION_DAYS=7

# -----------------------------------------------------------------------------
# AI providers
# -----------------------------------------------------------------------------
# DashScope credentials are required only when Aliyun cloud ASR is enabled.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_API_HOST=

# Optional model providers.
GROQ_API_KEY=
OPENROUTER_API_KEY=
REPLICATE_API_TOKEN=

# Optional TTS/audio-review overrides. Leave blank to use application defaults.
LEARNFLUX_AUDIO_REVIEW_MODEL=
LEARNFLUX_QWEN_TTS_MODEL=
LEARNFLUX_TTS_MODEL=
LEARNFLUX_TTS_VOICE=

# -----------------------------------------------------------------------------
# Optional local integrations
# -----------------------------------------------------------------------------
LONGCUT_BASE_URL=
LONGCUT_PROJECT_DIR=

WECHAT_CHANNELS_DECRYPT_SERVICE_URL=
WECHAT_CHANNELS_DECRYPT_SERVICE_PORT=
WECHAT_CHANNELS_DECRYPT_SERVICE_DIR=
