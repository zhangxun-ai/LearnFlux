# LearnFlux 环境变量模板：只提交此模板，不要在这里填写真实凭据。
# 首次使用，在项目根目录执行（已有 .env 时保留原文件）：
#   cp -n .env.example .env
#   chmod 600 .env
# 然后只编辑 .env；修改后执行 bash server.sh restart。
#
# 【本机基础使用】没有必须填写的环境变量，保留下面的 sqlite / local 即可。
# AI 学习：在自己的 .env 填写下面的 LEARNFLUX_LLM_* 三项。
# 环境变量非空时优先于网页设置 / 私有主配置，且不会写回设置数据库。
# 未填写环境变量的已有用户仍可沿用系统设置和私有主配置。
# 主配置模板见 config/config.example.jsonc，详细说明见 docs/guides/configuration.md。
#
# main.py 自动读取项目根目录 .env，已导出的进程环境变量优先。
# 此文件按 python-dotenv 语法读取，不要直接 source 执行。
# 独立 worker、迁移工具和 Agent CLI 有自己的参数/配置，不会自动加载这里。

# -----------------------------------------------------------------------------
# AI 学习必需：填写同一模型服务商提供的 Key、OpenAI 兼容接口地址与可用模型名。
# 通用 MODEL 同时用于校对、总结、问答等；不要填此服务商无法调用的模型。
# 主文字模型不会自动读取其他项目的 OPENAI_API_KEY / LLM_API_KEY / TIKHUB_API_KEY。
# -----------------------------------------------------------------------------
LEARNFLUX_LLM_API_KEY=
LEARNFLUX_LLM_BASE_URL=
LEARNFLUX_LLM_MODEL=
# 按需分别指定任务模型；非空时覆盖通用 MODEL：
# LEARNFLUX_LLM_CALIBRATE_MODEL=
# LEARNFLUX_LLM_SUMMARY_MODEL=
# LEARNFLUX_LLM_COLLECTION_SUMMARY_MODEL=
# LEARNFLUX_LLM_COLLECTION_SUMMARY_MODULE_MODEL=
# LEARNFLUX_LLM_VISUAL_LEARNING_OUTLINE_MODEL=
# LEARNFLUX_LLM_VISUAL_LEARNING_RENDER_MODEL=
# LEARNFLUX_LLM_STUDY_CHAT_MODEL=

# 可选：TikHub（对应社媒来源），纯文字学习留空。
LEARNFLUX_TIKHUB_API_KEY=
LEARNFLUX_TIKHUB_BASE_URL=

# 可选：本机入口与管理口令。留空沿用私有主配置（默认127.0.0.1:8000）。
# 初始化已生成独立随机口令；需要在环境中管理时自行生成，不填写固定示例。
LEARNFLUX_API_HOST=
LEARNFLUX_API_PORT=
LEARNFLUX_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# 默认本地存储：不需要数据库账号或对象存储密钥
# -----------------------------------------------------------------------------
LEARNFLUX_PERSISTENCE_BACKEND=sqlite
LEARNFLUX_OBJECT_BACKEND=local

# -----------------------------------------------------------------------------
# 可选：PostgreSQL。只有切换为 postgres 时，DATABASE_URL 才必填。
# 先按 docs/guides/postgresql.md 完成迁移；不要只改开关就连接现有数据库。
# DATABASE_URL 格式示例（仅格式，勿直接使用）：
# postgresql://USER:URL_ENCODED_PASSWORD@127.0.0.1:5432/learnflux?sslmode=disable
# 远程数据库的 SSL 参数以部署要求为准。密码特殊字符必须 URL 编码。
# -----------------------------------------------------------------------------
DATABASE_URL=

# 以下是部署/迁移辅助参数，不会自动替代或拼装上面的 DATABASE_URL。
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=learnflux
POSTGRES_SSLMODE=disable
POSTGRES_URL=

# -----------------------------------------------------------------------------
# 可选：S3。只有切换 LEARNFLUX_OBJECT_BACKEND=s3 时，下列五项才全部必填。
# Endpoint 必须为 HTTPS；不要公开存储桶或把密钥写到前端。
# -----------------------------------------------------------------------------
LEARNFLUX_S3_ENDPOINT_URL=
LEARNFLUX_S3_BUCKET=
LEARNFLUX_S3_REGION=
LEARNFLUX_S3_ACCESS_KEY_ID=
LEARNFLUX_S3_SECRET_ACCESS_KEY=
LEARNFLUX_S3_PRESIGN_TTL_SECONDS=900
LEARNFLUX_SOURCE_RETENTION_DAYS=7

# -----------------------------------------------------------------------------
# 可选：阿里云百炼云端 ASR。启用时下列三项全部必填。
# 还需在私有 config/config.jsonc 中启用 cloud_asr.enabled。
# 默认关闭；启用和实际调用可能收费，先确认服务商计费与任务报价。
# DASHSCOPE_API_HOST 格式：https://<workspace-id>.cn-beijing.maas.aliyuncs.com
# DASHSCOPE_API_KEY 也可供主配置内显式指定 api_key_env 的百炼次级模型端点使用；
# 这不会自动配置主 LLM 模型，基础文字学习可全部留空。
# -----------------------------------------------------------------------------
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_API_HOST=

# 仅开发者显式运行远程 ASR 付费基准测试时使用，普通用户留空。
GROQ_API_KEY=

# -----------------------------------------------------------------------------
# 可选：本地 LongCut / 视频号解密服务覆盖值，不填则沿用主配置。
# -----------------------------------------------------------------------------
LONGCUT_BASE_URL=
LONGCUT_PROJECT_DIR=

WECHAT_CHANNELS_DECRYPT_SERVICE_URL=
WECHAT_CHANNELS_DECRYPT_SERVICE_PORT=
WECHAT_CHANNELS_DECRYPT_SERVICE_DIR=

# 可选：部署到不同电脑时的服务地址、凭据和本机路径。
# 只覆盖配置值；相关可选能力还需按配置指南启用。
LEARNFLUX_CAPSWRITER_SERVER_URL=
LEARNFLUX_FUNASR_SERVER_URL=
LEARNFLUX_YOUTUBE_API_BASE_URL=
LEARNFLUX_YOUTUBE_API_KEY=
LEARNFLUX_OBSIDIAN_VAULT_PATH=
LEARNFLUX_OBSIDIAN_VAULT_ID=
LEARNFLUX_LLM_COLLECTOR_URL=
LEARNFLUX_LLM_COLLECTOR_PROJECT=
LEARNFLUX_LLM_COLLECTOR_API_KEY=

# 可选：手动 AI 图解专用 OpenAI 官方 Key，与主文字模型配置独立。
# 只有需要手动图解时填写；显式点击生成会产生模型费用，页面加载不会生图。
# 不能用 LEARNFLUX_LLM_API_KEY 或第三方文字转发地址代替。
OPENAI_API_KEY=

# 可选：飞书交付状态 / 日报集成私有配置路径。
# 未启用时保持注释，不要改成空字符串赋值，避免覆盖默认路径。
# 这里只连接已有配置；不会代替初始化、授权或启动独立归档 worker。
# LEARNFLUX_FEISHU_ARCHIVE_CONFIG=/absolute/private/path/feishu-archive.json
# LEARNFLUX_BRIEFINGS_CONFIG=/absolute/private/path/briefings.json

# server.sh 的启动管理参数（如 LEARNFLUX_UV_BIN）在运行脚本的进程环境设置，
# 不从本文件读取；通常无需配置。LEARNFLUX_API_PORT 则由脚本和应用共同读取。

# 仅开发者显式运行真实通知测试时使用，会向机器人发送消息。
# 测试脚本不自动加载此文件；需在安全的本机进程环境中提供这些变量。
# LEARNFLUX_TEST_FEISHU_WEBHOOK=
# LEARNFLUX_TEST_WECHAT_WEBHOOK=
