{
  "name": "LearnFlux",
  "short_name": "LearnFlux",
  "description": "视频/文档深度学习、系列学习、帖子/文章洞察与心流写作复盘。",
  "lang": "zh-CN",
  "dir": "ltr",
  "id": "/",
  "start_url": "/add_task_by_web",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "background_color": "#FBF8F3",
  "theme_color": "#E4503A",
  "categories": ["productivity", "education", "utilities"],
  "icons": [
    {
      "src": "/static/icon/learnflux-logo.png",
      "sizes": "1254x1254",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icon/learnflux-favicon-32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "/static/icon/learnflux-apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icon/learnflux-icon-256.png",
      "sizes": "256x256",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "开始解析",
      "short_name": "解析",
      "description": "提交链接或文件进行深度学习。",
      "url": "/add_task_by_web",
      "icons": [{ "src": "/static/icon/learnflux-icon-256.png", "sizes": "256x256" }]
    },
    {
      "name": "任务历史",
      "short_name": "历史",
      "description": "查看以前解析过的内容。",
      "url": "/static/history.html",
      "icons": [{ "src": "/static/icon/learnflux-icon-256.png", "sizes": "256x256" }]
    },
    {
      "name": "心流写作",
      "short_name": "写作",
      "description": "打开沉浸式写作与复盘记录空间。",
      "url": "/static/focus-studio.html",
      "icons": [{ "src": "/static/icon/learnflux-icon-256.png", "sizes": "256x256" }]
    }
  ]
}
